{
  "manifest_version": 3,
  "name": "Peek",
  "version": "0.4.0",
  "description": "Keeps a live, always-on-top thumbnail of a tab. Click the thumbnail to jump back to it.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Peek at this tab",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Peek at the current tab"
    }
  }
}
